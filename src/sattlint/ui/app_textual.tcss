        Screen {
            background: #f4efde;
            color: #001ba3;
            scrollbar-background: #b9d9df;
            scrollbar-background-hover: #c2c2c2;
            scrollbar-background-active: #ebebeb;
            scrollbar-color: #58787e;
            scrollbar-color-hover: #0077b3;
            scrollbar-color-active: #0077b3;
            scrollbar-corner-color: #b9d9df;
        }

        Footer {
            background: #58787e;
            color: #fbfbee;
        }

        #content-host {
            height: 1fr;
            layout: vertical;
            background: #f4efde;
        }

        #workspace-host {
            height: 1fr;
            layout: vertical;
            background: #f4efde;
        }

        #view-pane {
            height: 2fr;
            layout: vertical;
            margin: 0 1 1 1;
            background: #f4efde;
        }

        #workspace-host.analyze-split {
            layout: vertical;
        }

        #view-header {
            height: auto;
        }

        #view-copy {
            width: 1fr;
            height: auto;
            min-width: 40;
            overflow-y: auto;
        }

        #view-title,
        #view-description,
        #view-note {
            width: 1fr;
        }

        #view-side-actions {
            width: 32;
            height: auto;
            min-width: 24;
            margin-left: 1;
            align: right top;
        }

        #view-host {
            height: auto;
            min-height: 8;
            margin: 0;
            padding: 1 2;
            background: #e6decb;
            color: #000000;
            border: tall #0077b3;
            overflow-y: hidden;
        }

        #view-host.no-view-box {
            min-height: 0;
            padding: 0;
            background: transparent;
        }

        #view-host.no-view-box #view-header {
            display: none;
        }

        #workspace-host.analyze-split #view-pane {
            width: 1fr;
            height: 1fr;
        }

        #workspace-host.analyze-split #view-header {
            layout: vertical;
        }

        #workspace-host.analyze-split #view-copy {
            min-width: 0;
        }

        #workspace-host.analyze-split #view-side-actions {
            width: 1fr;
            min-width: 0;
            margin-left: 0;
            margin-top: 0;
            align: left top;
        }

        #workspace-host.no-output #view-pane {
            height: 1fr;
        }

        #workspace-host.no-output #view-host {
            width: 100%;
            border: none;
        }

        #workspace-host.no-output #setup-browser {
            margin-top: 0;
        }

        #output-pane {
            height: 1fr;
            min-height: 0;
            margin: 0;
            layout: vertical;
            background: #b9d9df;
            border: tall #0077b3;
        }

        #workspace-host.analyze-split #analyze-split-body {
            height: 1fr;
            min-height: 0;
            layout: horizontal;
        }

        #workspace-host.analyze-split #analyze-split-body #analyze-browser {
            width: 1fr;
            height: 1fr;
            min-height: 0;
        }

        #workspace-host.analyze-split #analyze-split-body #output-pane {
            width: 2fr;
            height: 1fr;
            min-height: 0;
            margin: 0 0 0 1;
        }

        #workspace-host.analyze-split #analyze-actions-primary {
            width: 100%;
        }

        #workspace-host.analyze-split #analyze-actions-primary Button.raised-button {
            width: 1fr;
        }

        #view-title {
            margin: 0 1 0 1;
            padding: 0 1;
            color: #16323b;
            text-style: bold;
        }

        #view-description {
            margin-top: 0;
        }

        #view-note {
            margin-top: 1;
            color: #58787e;
        }

        #view-actions {
            height: auto;
            margin-top: 0;
        }

        #analyze-browser {
            height: 1fr;
            min-height: 12;
            border: tall #0077b3;
            background: #b9d9df;
            padding: 0 1;
            overflow-y: auto;
        }

        #workspace-host.analyze-split #view-note {
            margin-top: 0;
        }

        #setup-browser {
            height: 1fr;
            min-height: 10;
            margin-top: 1;
        }

        #analyze-browser-left {
            width: 100%;
            height: 1fr;
            min-height: 4;
            padding: 0 1;
            overflow-y: auto;
            scrollbar-background: #b9d9df;
            scrollbar-background-hover: #c2c2c2;
            scrollbar-background-active: #ebebeb;
            scrollbar-color: #58787e;
            scrollbar-color-hover: #0077b3;
            scrollbar-color-active: #0077b3;
            scrollbar-corner-color: #b9d9df;
        }

        #analyze-browser-left Button.raised-button {
            width: 1fr;
            margin: 0 0 1 0;
            content-align: left middle;
        }

        #setup-targets-section {
            width: 1fr;
            min-width: 36;
            height: 1fr;
        }

        #setup-settings-section {
            width: 1fr;
            height: 1fr;
            margin-left: 1;
        }

        #settings-browser {
            width: 100%;
            height: 1fr;
            padding: 0 1;
        }

        #settings-settings-section {
            width: 1fr;
            height: 1fr;
            align: center top;
        }

        #settings-settings-col {
            width: 1fr;
            max-width: 100%;
            height: 1fr;
            overflow-y: auto;
            padding: 1;
        }

        #settings-group-run-history,
        #settings-group-output {
            width: 1fr;
        }

        #settings-group-run-history {
            margin-right: 1;
        }

        #settings-config-title {
            text-style: bold;
            padding: 1 2;
        }

        #results-browser {
            width: 100%;
            height: 1fr;
            padding: 0 1;
        }

        #results-runs-section {
            width: 1fr;
            min-width: 34;
            height: 1fr;
        }

        #results-runs-title {
            text-style: bold;
            padding: 1 2;
        }

        #results-runs-col {
            width: 1fr;
            height: 1fr;
            padding: 1 2;
            color: #001ba3;
            background: #b9d9df;
            border: tall #0077b3;
        }

        #results-runs-list {
            height: 1fr;
            background: transparent;
            color: #001ba3;
            border: none;
            margin: 0;
            scrollbar-background: #b9d9df;
            scrollbar-background-hover: #c2c2c2;
            scrollbar-background-active: #ebebeb;
            scrollbar-color: #58787e;
            scrollbar-color-hover: #0077b3;
            scrollbar-color-active: #0077b3;
            scrollbar-corner-color: #b9d9df;
        }

        #results-runs-list > ListItem {
            background: transparent;
            color: #001ba3;
        }

        #results-runs-list > ListItem.--highlight {
            background: #0077b3;
            color: #fbfbee;
        }

        #results-detail-section {
            width: 2fr;
            height: 1fr;
            margin-left: 1;
        }

        #results-tabs {
            height: auto;
            align: left middle;
            margin-bottom: 1;
        }

        .results-tab-button {
            width: 15;
            min-width: 15;
            max-width: 15;
            margin-right: 1;
            content-align: center middle;
        }

        #results-tree-host {
            width: 1fr;
            height: 1fr;
            background: #b9d9df;
            border: tall #0077b3;
            padding: 1 2;
            overflow-y: auto;
            scrollbar-background: #b9d9df;
            scrollbar-background-hover: #c2c2c2;
            scrollbar-background-active: #ebebeb;
            scrollbar-color: #58787e;
            scrollbar-color-hover: #0077b3;
            scrollbar-color-active: #0077b3;
            scrollbar-corner-color: #b9d9df;
        }

        #results-tree-host Tree {
            background: #b9d9df;
            color: #001ba3;
        }

        #results-tree-host Tree > .tree--guides {
            color: #58787e;
        }

        #results-tree-host Tree > .tree--guides-hover {
            color: #0077b3;
        }

        #results-tree-host Tree > .tree--cursor {
            background: #0077b3;
            color: #fbfbee;
        }

        #setup-targets-title,
        #setup-config-title {
            text-style: bold;
        }

        #setup-targets-col {
            width: 1fr;
            height: 1fr;
            padding: 1 2;
            color: #001ba3;
            background: #b9d9df;
            border: tall #0077b3;
        }

        #setup-target-inner {
            height: 1fr;
            background: #b9d9df;
            border: none;
            overflow: hidden;
        }

        .setup-group-box {
            height: auto;
            background: #f4efde;
            border: tall #0077b3;
            padding: 1 2;
            margin-bottom: 1;
            overflow: hidden;
        }

        .setup-group-box .setup-group-title {
            margin-top: 0;
        }

        #setup-settings-col {
            width: 1fr;
            height: 1fr;
            overflow-y: auto;
            scrollbar-background: #b9d9df;
            scrollbar-background-hover: #c2c2c2;
            scrollbar-background-active: #ebebeb;
            scrollbar-color: #58787e;
            scrollbar-color-hover: #0077b3;
            scrollbar-color-active: #0077b3;
            scrollbar-corner-color: #b9d9df;
        }

        #setup-target-listview {
            height: 1fr;
            background: transparent;
            color: #001ba3;
            border: none;
            margin: 0;
            scrollbar-background: #b9d9df;
            scrollbar-background-hover: #c2c2c2;
            scrollbar-background-active: #ebebeb;
            scrollbar-color: #58787e;
            scrollbar-color-hover: #0077b3;
            scrollbar-color-active: #0077b3;
            scrollbar-corner-color: #b9d9df;
        }

        #setup-target-listview > ListItem {
            background: transparent;
            color: #001ba3;
        }

        #setup-target-listview > ListItem.--highlight {
            background: #0077b3;
            color: #fbfbee;
        }

        #setup-target-actions {
            height: auto;
            margin-top: 1;
            background: #b9d9df;
        }

        #setup-target-actions Button.raised-button {
            width: auto;
            margin-right: 1;
        }

        .setup-section-title {
            text-style: bold;
            margin-bottom: 1;
        }

        .setup-group-title {
            text-style: bold;
            margin-top: 1;
            color: #58787e;
        }

        .setup-row {
            height: auto;
            min-height: 5;
            margin-top: 0;
            align: left middle;
        }

        .setup-row-label {
            width: 1fr;
            height: auto;
            min-height: 5;
            content-align: left middle;
            padding: 1 2;
            margin-left: 1;
            background: #b9d9df;
            border: round #0077b3;
            color: #001ba3;
        }

        .setup-row-button {
            width: 15;
            min-width: 15;
            max-width: 15;
            content-align: center middle;
        }

        .setup-row-button-compact {
            width: 11;
            min-width: 11;
            max-width: 11;
            content-align: center middle;
        }

        .browser-section-title {
            margin: 0 0 1 0;
            text-style: bold;
        }

        .browser-empty-state {
            margin: 0 0 1 0;
            color: #58787e;
        }

        .planner-section-note {
            margin: 0 0 1 0;
            color: #58787e;
        }

        #analyze-browser-left SelectionList {
            height: auto;
            max-height: 999;
            min-height: 4;
            margin: 0 0 1 0;
            background: #f5edd5;
            color: #001ba3;
            border: tall #0077b3;
        }

        #analyze-actions-primary {
            height: auto;
            margin-top: 0;
        }

        #analyze-actions-primary {
            overflow-x: auto;
            scrollbar-background: #b9d9df;
            scrollbar-background-hover: #c2c2c2;
            scrollbar-background-active: #ebebeb;
            scrollbar-color: #58787e;
            scrollbar-color-hover: #0077b3;
            scrollbar-color-active: #0077b3;
            scrollbar-corner-color: #b9d9df;
            scrollbar-size-horizontal: 1;
        }

        .is-hidden {
            display: none;
        }

        #interaction-host {
            display: none;
            height: auto;
            margin: 0 1 1 1;
            background: #f4efde;
        }

        #interaction-host.active {
            display: block;
        }

        #interaction-screen {
            width: 100%;
            height: auto;
            padding: 1 2 2 2;
            background: #f4efde;
        }

        #top-bar {
            dock: top;
            height: auto;
        }

        #menubar {
            height: auto;
            background: #e6decb;
        }

        #nav-tabs {
            height: 3;
            background: #d5cdb8;
            align: left middle;
        }

        .nav-tab {
            width: auto;
            height: 3;
            padding: 0 2;
            color: #373737;
            background: #d5cdb8;
            text-style: bold;
        }

        .nav-tab:hover {
            background: #bfb7a2;
        }

        .nav-tab.nav-tab-active {
            background: #f4efde;
            color: #001ba3;
        }

        #menubar-actions {
            height: 3;
            align: left middle;
        }

        Button.menubar-button {
            width: auto;
            min-width: 0;
            height: 1;
            padding: 0 1;
            color: #373737;
            background: #e6decb;
            text-style: bold;
            border: none !important;
            border-top: none !important;
            border-bottom: none !important;
            border-left: none !important;
            border-right: none !important;
            outline: none;
            tint: transparent;
            background-tint: transparent;
        }

        Button.menubar-button:hover,
        Button.menubar-button:focus {
            background: #d5cdb8;
            color: #000000;
            outline: none;
            border: none !important;
            border-top: none !important;
            border-bottom: none !important;
            border-left: none !important;
            border-right: none !important;
            tint: transparent;
            background-tint: transparent;
        }

        Button.raised-button {
            min-width: 12;
            height: 3;
            padding: 0 2;
            background: #b0b0b0;
            color: #000000;
            opacity: 100%;
            text-opacity: 100%;
            tint: transparent;
            background-tint: transparent;
            content-align: center middle;
            text-style: bold;
            outline: none;
            border: none;
        }

        Button.raised-button:hover,
        Button.raised-button:focus {
            background: #cacaca;
            color: #000000;
            outline: none;
            border: none;
        }

        #view-actions Button.raised-button,
        #analyze-actions-primary Button.raised-button,
        #interaction-actions Button.raised-button {
            width: auto;
            margin-right: 1;
        }

        #analyze-actions-primary Button.raised-button {
            min-width: 0;
            padding: 0 0;
        }

        #analyze-clear-output {
            margin-right: 0;
        }

        #interaction-options {
            height: auto;
        }

        #analyze-browser-left SelectionList > .selection-list--button,
        #analyze-browser-left SelectionList > .selection-list--button {
            color: #f4efde;
            background: #f4efde;
        }

        #analyze-browser-left SelectionList > .selection-list--button-highlighted {
            color: #d8d4c8;
            background: #d8d4c8;
        }

        #analyze-browser-left SelectionList > .selection-list--button-selected,
        #analyze-browser-left SelectionList > .selection-list--button-selected {
            color: #001ba3;
            background: #f4efde;
        }

        #analyze-browser-left SelectionList > .selection-list--button-selected-highlighted {
            color: #001ba3;
            background: #d8d4c8;
        }

        #analyze-browser-left SelectionList > .option-list--option {
            color: #001ba3;
            background: #f4efde;
        }

        #analyze-browser-left SelectionList > .option-list--option-highlighted,
        #analyze-browser-left SelectionList:focus > .option-list--option-highlighted,
        #analyze-browser-left SelectionList > .option-list--option-hover {
            color: #001ba3;
            background: #d8d4c8;
        }

        #interaction-options Button.raised-button {
            width: 1fr;
            margin: 0 0 1 0;
            content-align: left middle;
        }

        #output {
            height: 1fr;
            min-height: 3;
            margin: 0;
            padding: 1 2;
            background: transparent;
            color: #001ba3;
            border: none;
            scrollbar-background: #b9d9df;
            scrollbar-background-hover: #c2c2c2;
            scrollbar-background-active: #ebebeb;
            scrollbar-color: #58787e;
            scrollbar-color-hover: #0077b3;
            scrollbar-color-active: #0077b3;
            scrollbar-corner-color: #b9d9df;
        }

        #output-title {
            margin: 0;
            padding: 1 2 0 2;
            color: #001ba3;
            text-style: bold;
        }

        #interaction-dialog {
            width: 1fr;
            height: auto;
            margin: 1 0 0 0;
            padding: 1 2;
            background: #b9d9df;
            color: #001ba3;
            border: heavy #0077b3;
            scrollbar-background: #b9d9df;
            scrollbar-background-hover: #c2c2c2;
            scrollbar-background-active: #ebebeb;
            scrollbar-color: #58787e;
            scrollbar-color-hover: #0077b3;
            scrollbar-color-active: #0077b3;
            scrollbar-corner-color: #b9d9df;
        }

        #interaction-title {
            color: #001ba3;
            text-style: bold;
        }

        #interaction-intro,
        #interaction-message {
            color: #001ba3;
        }

        #interaction-ledger {
            margin: 1 0;
