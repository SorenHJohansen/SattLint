{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "allow",
      "rm *": "deny",
      "git": "deny",
      "git *": "deny",
      "git*": "deny",
      "cd * && git*": "deny",
      "cd *; git*": "deny",
      "* && git*": "deny",
      "*; git*": "deny",
      "git log*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "gh repo create*": "deny",
      "gh repo rename*": "deny",
      "gh repo transfer*": "deny"
    },
    "edit": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "task": "allow",
    "question": "allow",
    "lsp": "allow",
    "skill": "allow"
  },
  "mcp": {
    "semble": {
      "type": "local",
      "command": ["uvx", "--from", "semble[mcp]", "semble"]
    }
  },
  "lsp": {
    "pyright": {
      "command": [".venv/bin/pyright-langserver", "--stdio"],
      "extensions": [".py"]
    }
  }
}
